# Required for persistent JSON content, blog posts, leads, images and backups on Vercel.
# Create a PRIVATE Vercel Blob store and connect it to this project.
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAIL=admin@example.com
# Generate these with node scripts/setup-admin.cjs
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Your commercial key, or GPL only when your project complies with GPL terms.
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=
# Authorized ZeroGPT Business API bearer token for POST /api/detect/detectText.
# A fixed token may expire. Prefer the account credentials below for automatic login/refresh.
ZERO_GPT_API_TOKEN=
ZERO_GPT_EMAIL=
ZERO_GPT_PASSWORD=
# Set only if ZeroGPT has granted your account authorized server-side humanizer API access.
# The captured browser endpoint is not listed in the public Business API documentation.
ZERO_GPT_HUMANIZER_TOKEN=
# Endpoint supplied or approved by ZeroGPT for your business account (api.zerogpt.com only).
ZERO_GPT_HUMANIZER_API_URL=
